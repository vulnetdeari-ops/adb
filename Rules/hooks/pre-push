#!/usr/bin/env bash
# Method hook (installed by setup-into-project.sh). Blocks pushes to main/master
# unless the owner said "Push Main". For that one push: ALLOW_MAIN_PUSH=1 git push ...
set -u

remote="${1:-origin}"

if [ "${ALLOW_MAIN_PUSH:-}" = "1" ]; then
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      # Deleting the remote branch is not a push of content.
      if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
      fi
      echo "BLOCKED: push to ${remote_ref#refs/heads/} on $remote." >&2
      blocked=1
      ;;
  esac
done

if [ $blocked -eq 1 ]; then
  echo "Push to main only when the owner says \"Push Main\". Then: ALLOW_MAIN_PUSH=1 git push $remote main" >&2
  exit 1
fi
exit 0
